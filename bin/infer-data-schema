#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $candidate) {
    if (\is_file($candidate)) {
        require $candidate;

        break;
    }
}

if (!\class_exists(\ZachWatkins\InferDataSchema\Console::class)) {
    \fwrite(\STDERR, 'Unable to locate the Composer autoloader.' . \PHP_EOL);

    exit(1);
}

exit((new \ZachWatkins\InferDataSchema\Console())->run($argv));
